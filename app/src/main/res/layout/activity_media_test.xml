<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/noga_black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/test_player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/noga_black"
        app:resize_mode="fit"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/noga_scrim"
        android:orientation="vertical"
        android:paddingStart="@dimen/tv_safe_horizontal"
        android:paddingTop="18dp"
        android:paddingEnd="@dimen/tv_safe_horizontal"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="@string/test_title"
            android:textAllCaps="true"
            android:textColor="@color/noga_orange"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/test_detail"
            style="@style/NogaValue"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/test_state"
            style="@style/NogaCaption"
            android:layout_marginTop="4dp" />

        <TextView
            style="@style/NogaCaption"
            android:layout_marginTop="10dp"
            android:alpha="0.7"
            android:text="@string/test_hint" />
    </LinearLayout>
</FrameLayout>
