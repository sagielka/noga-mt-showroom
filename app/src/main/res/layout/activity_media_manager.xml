<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/noga_bg"
    android:orientation="vertical"
    android:paddingStart="@dimen/tv_safe_horizontal"
    android:paddingTop="@dimen/tv_safe_vertical"
    android:paddingEnd="@dimen/tv_safe_horizontal"
    android:paddingBottom="@dimen/tv_safe_vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="6dp"
            android:layout_height="30dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/accent_bar" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.1"
            android:text="@string/media_manager_title"
            android:textAllCaps="true"
            android:textColor="@color/noga_text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/value_health"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="14dp"
            android:textColor="@color/noga_green"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="@color/noga_divider" />

    <TextView
        android:id="@+id/value_sync_banner"
        style="@style/NogaValue"
        android:layout_marginTop="8dp"
        android:textColor="@color/noga_orange" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- LEFT: source + counters -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.3"
            android:paddingEnd="24dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView style="@style/NogaSectionLabel" android:text="@string/media_source" />
                <TextView android:id="@+id/value_source" style="@style/NogaValue" />

                <TextView style="@style/NogaSectionLabel" android:text="@string/media_permission" />
                <TextView android:id="@+id/value_permission" style="@style/NogaValue" />

                <TextView style="@style/NogaSectionLabel" android:text="@string/media_source" />
                <TextView android:id="@+id/value_source_state" style="@style/NogaValue" />

                <TextView
                    android:id="@+id/value_counters"
                    style="@style/NogaValue"
                    android:layout_marginTop="18dp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="3dp"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/value_storage_line"
                    style="@style/NogaValue"
                    android:layout_marginTop="16dp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="3dp"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/value_low_storage"
                    style="@style/NogaValue"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/noga_red"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

        <!-- RIGHT: actions -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView style="@style/NogaSectionLabel" android:text="@string/section_actions" />

                <Button android:id="@+id/btn_sync_now" style="@style/NogaButton" android:text="@string/action_sync_now" />
                <Button android:id="@+id/btn_rescan" style="@style/NogaButton" android:text="@string/btn_rescan_videos" />
                <Button android:id="@+id/btn_change_storage" style="@style/NogaButton" android:text="@string/action_change_storage" />
                <Button android:id="@+id/btn_view_matched" style="@style/NogaButton" android:text="@string/btn_view_matched" />
                <Button android:id="@+id/btn_view_missing" style="@style/NogaButton" android:text="@string/btn_view_missing" />
                <Button android:id="@+id/btn_view_failed" style="@style/NogaButton" android:text="@string/btn_view_failed" />
                <Button android:id="@+id/btn_view_unmatched" style="@style/NogaButton" android:text="@string/btn_view_unmatched" />
                <Button android:id="@+id/btn_view_duplicates" style="@style/NogaButton" android:text="@string/media_duplicates" />
                <Button android:id="@+id/btn_clean_unused" style="@style/NogaButton" android:text="@string/btn_clean_unused" />
                <Button android:id="@+id/btn_test_local" style="@style/NogaButton" android:text="@string/btn_test_local" />
                <Button android:id="@+id/btn_test_by_id" style="@style/NogaButton" android:text="@string/btn_test_by_id" />
                <Button android:id="@+id/btn_clear_index" style="@style/NogaButton" android:text="@string/btn_clear_index" />
                <Button android:id="@+id/btn_close" style="@style/NogaButton" android:text="@string/btn_close" />

                <TextView
                    style="@style/NogaCaption"
                    android:layout_marginTop="16dp"
                    android:alpha="0.7"
                    android:text="Expected drive layout: NOGA-MT/videos/*.mp4\nClearing the index never deletes media files." />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
