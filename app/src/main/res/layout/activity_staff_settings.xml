<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/noga_bg"
    android:orientation="vertical"
    android:paddingStart="@dimen/tv_safe_horizontal"
    android:paddingTop="@dimen/tv_safe_vertical"
    android:paddingEnd="@dimen/tv_safe_horizontal"
    android:paddingBottom="@dimen/tv_safe_vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="6dp"
            android:layout_height="30dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/accent_bar" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.1"
            android:text="@string/staff_settings_title"
            android:textAllCaps="true"
            android:textColor="@color/noga_text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/header_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NOGA MT"
            android:textColor="@color/noga_orange"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/noga_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- LEFT: read-only status -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.15"
            android:paddingEnd="24dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView style="@style/NogaSectionLabel" android:text="@string/section_webapp" />
                <TextView android:id="@+id/value_start_url" style="@style/NogaValue" />

                <TextView style="@style/NogaSectionLabel" android:text="@string/section_network" />
                <TextView android:id="@+id/value_network" style="@style/NogaValue" />

                <TextView style="@style/NogaSectionLabel" android:text="@string/section_webview" />
                <TextView android:id="@+id/value_webview" style="@style/NogaValue" />

                <TextView style="@style/NogaSectionLabel" android:text="@string/section_application" />
                <TextView android:id="@+id/value_app" style="@style/NogaValue" />
                <TextView android:id="@+id/value_device" style="@style/NogaCaption" />

                <TextView style="@style/NogaSectionLabel" android:text="@string/section_media" />
                <TextView android:id="@+id/value_media_folder" style="@style/NogaValue" />
                <TextView android:id="@+id/value_media_count" style="@style/NogaCaption" />

                <TextView
                    android:id="@+id/value_notice"
                    style="@style/NogaCaption"
                    android:layout_marginTop="24dp"
                    android:alpha="0.7" />
            </LinearLayout>
        </ScrollView>

        <!-- RIGHT: toggles + actions -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView style="@style/NogaSectionLabel" android:text="@string/section_display" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_keep_awake"
                    style="@style/NogaSwitch"
                    android:text="@string/label_keep_awake" />

                <TextView style="@style/NogaSectionLabel" android:text="@string/section_startup" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_autostart"
                    style="@style/NogaSwitch"
                    android:text="@string/label_autostart" />

                <TextView style="@style/NogaSectionLabel" android:text="@string/section_recovery" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_recovery"
                    style="@style/NogaSwitch"
                    android:text="@string/label_recovery" />

                <TextView style="@style/NogaSectionLabel" android:text="@string/section_actions" />

                <Button android:id="@+id/btn_reload" style="@style/NogaButton" android:text="@string/action_reload" />
                <Button android:id="@+id/btn_force_refresh" style="@style/NogaButton" android:text="@string/action_force_refresh" />
                <Button android:id="@+id/btn_select_folder" style="@style/NogaButton" android:text="@string/action_select_folder" />
                <Button android:id="@+id/btn_rescan" style="@style/NogaButton" android:text="@string/action_rescan" />
                <Button android:id="@+id/btn_media_manager" style="@style/NogaButton" android:text="@string/media_manager_title" />
                <Button android:id="@+id/btn_clear_cache" style="@style/NogaButton" android:text="@string/action_clear_cache" />
                <Button android:id="@+id/btn_change_url" style="@style/NogaButton" android:text="@string/action_change_url" />
                <Button android:id="@+id/btn_network_settings" style="@style/NogaButton" android:text="@string/action_network_settings" />
                <Button android:id="@+id/btn_return" style="@style/NogaButton" android:text="@string/action_return" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
