<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/noga_bg"
    android:orientation="vertical"
    android:paddingStart="@dimen/tv_safe_horizontal"
    android:paddingTop="@dimen/tv_safe_vertical"
    android:paddingEnd="@dimen/tv_safe_horizontal"
    android:paddingBottom="@dimen/tv_safe_vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="6dp"
            android:layout_height="34dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/accent_bar" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.1"
            android:text="@string/first_run_title"
            android:textAllCaps="true"
            android:textColor="@color/noga_text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/offline_brand"
            android:textColor="@color/noga_orange"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        style="@style/NogaCaption"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="18dp"
        android:text="@string/first_run_intro" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/btn_internal"
                style="@style/NogaButton"
                android:text="@string/first_run_internal" />

            <TextView
                style="@style/NogaCaption"
                android:layout_marginBottom="14dp"
                android:text="@string/first_run_internal_hint" />

            <Button
                android:id="@+id/btn_usb"
                style="@style/NogaButton"
                android:text="@string/first_run_usb" />

            <TextView
                style="@style/NogaCaption"
                android:layout_marginBottom="14dp"
                android:text="@string/first_run_usb_hint" />

            <Button
                android:id="@+id/btn_skip"
                style="@style/NogaButton"
                android:text="@string/first_run_skip" />

            <TextView
                style="@style/NogaCaption"
                android:layout_marginBottom="14dp"
                android:text="@string/first_run_skip_hint" />

            <TextView
                android:id="@+id/status"
                style="@style/NogaValue"
                android:layout_marginTop="10dp"
                android:textColor="@color/noga_orange" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
